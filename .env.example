# Copie para .env.local e preencha. .env.local nunca é versionado.

# --- Aplicação ---------------------------------------------------------------
# URL base usada em redirects de auth, links de convite e retorno do Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (M8+) ----------------------------------------------------------
# Project Settings > API Keys no painel do Supabase. O formato sb_publishable_ /
# sb_secret_ substitui o par anon / service_role em JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ignora RLS. Só em webhooks e rotinas admin no servidor. Nunca no cliente.
SUPABASE_SECRET_KEY=
# Usada para verificar JWTs de sessão sem round-trip ao Auth.
SUPABASE_JWKS_URL=

# --- Stripe (M14) ------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Gerado por `stripe listen` em dev; no painel do Stripe em produção.
STRIPE_WEBHOOK_SECRET=
# Price ID do plano Pro — começa com `price_`, NÃO com `prod_`.
# O `prod_` identifica o produto; o checkout precisa do preço, que é o que
# carrega valor, moeda e recorrência. Trocar um pelo outro só falha na hora de
# criar a Checkout Session.
# Achar o seu: Stripe > Catálogo de produtos > o produto > seção Preços.
STRIPE_PRICE_ID_PRO=

# --- Resend (M10) ------------------------------------------------------------
# Opcionais: sem eles o convite continua sendo gravado e a tela mostra o link
# para repassar à mão. Só o ENVIO automático deixa de acontecer.
RESEND_API_KEY=
# Remetente. Precisa ser um endereço de domínio VERIFICADO em
# resend.com/domains — o Resend recusa qualquer outro com 403.
#
# Sem domínio próprio, use o sandbox `onboarding@resend.dev`, que entrega
# APENAS para o e-mail dono da conta Resend; convite para terceiros volta com
# `emailDelivered: false` e cai no fluxo do link manual.
#
# `localhost` não serve aqui: o remetente precisa de DNS público (SPF/DKIM)
# para o provedor do destinatário poder validar. É independente de
# NEXT_PUBLIC_SITE_URL, que pode seguir em localhost.
RESEND_FROM_EMAIL=PipeFlow <onboarding@resend.dev>
