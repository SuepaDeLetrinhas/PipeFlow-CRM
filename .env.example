# Copie para .env.local e preencha. .env.local nunca é versionado.

# --- Aplicação ---------------------------------------------------------------
# URL base usada em redirects de auth, links de convite e retorno do Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (M8+) ----------------------------------------------------------
# Project Settings > API Keys no painel do Supabase. O formato sb_publishable_ /
# sb_secret_ substitui o par anon / service_role em JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ignora RLS. Só em webhooks e rotinas admin no servidor. Nunca no cliente.
SUPABASE_SECRET_KEY=
# Usada para verificar JWTs de sessão sem round-trip ao Auth.
SUPABASE_JWKS_URL=

# --- Stripe (M14) ------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Gerado por `stripe listen` em dev; no painel do Stripe em produção.
STRIPE_WEBHOOK_SECRET=
# Price ID do plano Pro (R$ 49/mês).
STRIPE_PRICE_ID_PRO=

# --- Resend (M10) ------------------------------------------------------------
RESEND_API_KEY=
# Remetente verificado no domínio configurado no Resend.
RESEND_FROM_EMAIL=PipeFlow <nao-responda@exemplo.com.br>
